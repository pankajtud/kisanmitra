# Local Postgres. Migrations are forward-only and checked in (CLAUDE.md §14).
DATABASE_URL=postgres://localhost:5432/kisanmitra

PORT=3100
HOST=0.0.0.0

# Photos live on the local filesystem behind a storage interface, so this can
# move to S3/MinIO later without touching callers (CLAUDE.md §4).
UPLOAD_DIR=./uploads

# M0 has no auth. The API runs as this seeded user until M2.
# Printed by `npm run db:seed`.
DEV_USER_ID=
DEV_HOUSEHOLD_ID=
