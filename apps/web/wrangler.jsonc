// Deploy config for Cloudflare Workers Static Assets.
//
// There is no Worker script here — `assets` with no `main` deploys the built
// PWA as pure static files, which is all this app needs: everything runs on the
// phone and there is no server call anywhere in the client (CLAUDE.md §2.1).
//
// Wrangler refuses to run at an npm workspace root — it will not guess which
// app in the monorepo to deploy — so it has to run with this directory as its
// working directory. `npm run -w` does that from anywhere in the repo:
//
//   npm run deploy -w @kisanmitra/web
//
// Passing `--config apps/web/wrangler.jsonc` from the root also works, but the
// script is what the deploy is configured to call, so it is the tested path.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kisanmitra",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": "./dist",
    // Navigation is state rather than routes (§10), so every path serves the
    // shell. This is the only place that is configured: the equivalent
    // `/* /index.html 200` in a _redirects file is rejected by Workers Assets
    // as a redirect loop, because the rule also matches /index.html itself.
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
